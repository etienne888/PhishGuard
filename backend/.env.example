# Core
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+pg8000://phishguard_user:password@localhost:5432/phishguard_db
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
FRONTEND_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5174/

# Email verification (leave unset for development logging)
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# SMS and WhatsApp through Twilio (leave unset for development logging)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Mailbox scanner (Gmail / Outlook OAuth) - see app/services/mailbox_service.py
# Google: Cloud Console > enable the Gmail API > OAuth client (reuses GOOGLE_CLIENT_ID/SECRET),
#   authorised redirect URI: <MAILBOX_REDIRECT_BASE>/api/mailbox/callback/gmail ; add test users (testing mode, max 100)
# Microsoft: Azure portal > App registrations (accounts in any org + personal) > redirect URI
#   <MAILBOX_REDIRECT_BASE>/api/mailbox/callback/outlook ; API permissions Mail.Read, offline_access
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MAILBOX_REDIRECT_BASE=http://localhost:5173
# Any long random string (encrypts stored OAuth tokens; defaults to a key derived from SECRET_KEY)
MAILBOX_ENCRYPTION_KEY=
MAILBOX_SYNC_MINUTES=5
MAILBOX_INITIAL_DAYS=14

# "Forward it to PhishGuard" inbox, polled over IMAP (e.g. a dedicated Gmail address + app password)
INBOUND_IMAP_HOST=
INBOUND_IMAP_PORT=993
INBOUND_IMAP_USER=
INBOUND_IMAP_PASSWORD=
INBOUND_ADDRESS=

# Background jobs (mailbox sync, forwarded emails, correlation, OpenPhish, allowlist health)
SCHEDULER_ENABLED=true
