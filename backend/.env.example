# Core
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+pg8000://phishguard_user:password@localhost:5432/phishguard_db
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5174/

# Email verification (leave unset for development logging)
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# SMS and WhatsApp through Twilio (leave unset for development logging)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=